{
  "name": "color-guesser",
  "version": "1.0.0",
  "private": true,
  "description": "색을 맞히는 웹 게임과 문제 제작기 — Cloudflare Pages",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-local.js",
    "start": "node scripts/start-local.js",
    "validate-data": "node scripts/validate-data.js",
    "import-question": "node scripts/import-question.js",
    "test": "node scripts/test-color.js",
    "test:problem-maker": "node scripts/test-problem-maker.js",
    "generate-sample-assets": "node scripts/generate-sample-assets.js",
    "build": "npm run validate-data && node scripts/build.js",
    "predev": "node scripts/prepare-vendor.js",
    "prestart": "node scripts/prepare-vendor.js",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "wrangler": "4.132.0"
  }
}
