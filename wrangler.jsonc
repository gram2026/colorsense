{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colorguesser",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}

